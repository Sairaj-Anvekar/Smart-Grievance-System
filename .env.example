# ============================================================
# Smart Grievance System — Environment Variables
# Copy this file to .env and fill in the values
# ============================================================

# ---------- App ----------
APP_NAME=smart-grievance-system
APP_ENV=development
DEBUG=true

# ---------- Backend (FastAPI) ----------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_PREFIX=/api/v1

# ---------- Security ----------
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_ALGORITHM=HS256
ADMIN_ACCESS_TOKEN_EXPIRE_MINUTES=15
ADMIN_REFRESH_TOKEN_EXPIRE_HOURS=24
WORKER_ACCESS_TOKEN_EXPIRE_HOURS=24

# ---------- Database (PostgreSQL + PostGIS) ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=grievance_db
POSTGRES_USER=grievance_user
POSTGRES_PASSWORD=change-me-strong-password
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0

# ---------- Celery ----------
CELERY_BROKER_URL=redis://${REDIS_HOST}:${REDIS_PORT}/1
CELERY_RESULT_BACKEND=redis://${REDIS_HOST}:${REDIS_PORT}/2

# ---------- File Storage (MinIO / S3) ----------
STORAGE_BACKEND=minio
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=grievance-uploads
MINIO_USE_SSL=false
# Production: switch to S3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
# AWS_REGION=ap-south-1

# ---------- Telegram Bot ----------
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_WEBHOOK_SECRET=random-webhook-secret-string
TELEGRAM_WEBHOOK_URL=https://yourdomain.com/api/v1/webhook/telegram

# ---------- Session (Redis) ----------
SESSION_TTL_MINUTES=30
SESSION_IDLE_PROMPT_MINUTES=15

# ---------- Task Allocation ----------
WORKER_DAILY_TASK_LIMIT=20
SHIFT_START_HOUR=6
PRIORITY_WEIGHT=0.40
ELAPSED_TIME_WEIGHT=0.35
QUEUE_POSITION_WEIGHT=0.15
CARRY_FORWARD_WEIGHT=0.10

# ---------- Rate Limiting ----------
ADMIN_LOGIN_RATE_LIMIT=3/minute
WORKER_LOGIN_RATE_LIMIT=5/hour
CITIZEN_COMPLAINT_RATE_LIMIT=5/day

# ---------- AI/ML ----------
IMAGE_CLASSIFIER_MODEL_PATH=app/ml/models/mobilenetv2_classifier.h5
TEXT_CLASSIFIER_MODEL_PATH=app/ml/models/distilbert_classifier
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.70
AUTO_REJECT_CONFIDENCE_THRESHOLD=0.50

# ---------- CORS ----------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------- Logging ----------
LOG_LEVEL=INFO
LOG_FORMAT=json
