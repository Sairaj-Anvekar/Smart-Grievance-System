# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg
.eggs/
*.whl
pip-log.txt
pip-delete-this-directory.txt

# Virtual environments
.venv/
venv/
ENV/
env/

# ---------- Node.js ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Build output
frontend/dist/
frontend/build/

# ---------- Environment ----------
.env
.env.local
.env.*.local
!.env.example

# ---------- Docker ----------
# Don't ignore Dockerfiles or compose files
# But ignore local docker data
docker-data/

# ---------- IDE ----------
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/
*.sublime-project
*.sublime-workspace

# ---------- OS ----------
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# ---------- ML Models ----------
# Large model files — tracked via Git LFS or downloaded at build time
backend/app/ml/models/*.h5
backend/app/ml/models/*.pt
backend/app/ml/models/*.onnx
backend/app/ml/models/*.tflite
backend/app/ml/models/*.pkl
!backend/app/ml/models/.gitkeep

# ---------- Jupyter ----------
.ipynb_checkpoints/
*.ipynb_checkpoints

# ---------- Testing ----------
htmlcov/
.coverage
.coverage.*
.pytest_cache/
.tox/
nosetests.xml
coverage.xml

# ---------- Logs ----------
*.log
logs/

# ---------- MinIO / S3 local data ----------
minio-data/

# ---------- Database ----------
*.sqlite3
*.db

# ---------- Alembic ----------
# Don't ignore migration files, but ignore auto-generated temp
backend/alembic/versions/__pycache__/

# ---------- Misc ----------
*.bak
*.tmp
*.temp
.cache/

# ---------- Team ----------
# Personal task/contribution files — local only
team/
